{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambient Status Dashboard",
  "version": "0.1.0",
  "identifier": "com.status-dashboard.desktop",
  "build": {
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ambient Status Dashboard",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4317 ws://127.0.0.1:4317; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [],
    "externalBin": ["binaries/status-service-runtime"],
    "resources": {
      "generated/service/": "service/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
